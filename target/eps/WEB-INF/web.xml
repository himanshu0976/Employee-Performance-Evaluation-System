<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Employee Performance Evaluation System</display-name>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <!-- Filters -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.eps.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.eps.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.eps.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern></url-pattern>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.eps.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.eps.controller.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DepartmentServlet</servlet-name>
        <servlet-class>com.eps.controller.DepartmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DepartmentServlet</servlet-name>
        <url-pattern>/admin/departments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployeeServlet</servlet-name>
        <servlet-class>com.eps.controller.EmployeeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeServlet</servlet-name>
        <url-pattern>/admin/employees</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EvaluationCriteriaServlet</servlet-name>
        <servlet-class>com.eps.controller.EvaluationCriteriaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EvaluationCriteriaServlet</servlet-name>
        <url-pattern>/admin/criteria</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EvaluationCycleServlet</servlet-name>
        <servlet-class>com.eps.controller.EvaluationCycleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EvaluationCycleServlet</servlet-name>
        <url-pattern>/admin/cycles</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminReportServlet</servlet-name>
        <servlet-class>com.eps.controller.AdminReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminReportServlet</servlet-name>
        <url-pattern>/admin/reports</url-pattern>
        <url-pattern>/admin/reports/export</url-pattern>
        <url-pattern>/admin/reports/chart-data</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManagerDashboardServlet</servlet-name>
        <servlet-class>com.eps.controller.ManagerDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManagerDashboardServlet</servlet-name>
        <url-pattern>/manager/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManagerEvaluationServlet</servlet-name>
        <servlet-class>com.eps.controller.ManagerEvaluationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManagerEvaluationServlet</servlet-name>
        <url-pattern>/manager/evaluations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployeeDashboardServlet</servlet-name>
        <servlet-class>com.eps.controller.EmployeeDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeDashboardServlet</servlet-name>
        <url-pattern>/employee/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployeeHistoryServlet</servlet-name>
        <servlet-class>com.eps.controller.EmployeeHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeHistoryServlet</servlet-name>
        <url-pattern>/employee/history</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployeeEvaluationDetailServlet</servlet-name>
        <servlet-class>com.eps.controller.EmployeeEvaluationDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeEvaluationDetailServlet</servlet-name>
        <url-pattern>/employee/evaluation-view</url-pattern>
        <url-pattern>/employee/evaluation</url-pattern>
    </servlet-mapping>

    <!-- Session configuration (30 minutes timeout) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <name>EPS_JSESSIONID</name>
        </cookie-config>
    </session-config>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/login</location>
    </error-page>

</web-app>
